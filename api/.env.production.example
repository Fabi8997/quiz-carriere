# ── PRODUZIONE — copiare in .env sul server / impostare come secrets su Fly.io ──
# Generare le chiavi con:
#   python -c "import secrets; print(secrets.token_hex(32))"

# Database PostgreSQL Supabase
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Asset su Supabase Storage
ASSETS_LOCAL_DIR=
ASSETS_BASE_URL=https://[PROJECT-REF].supabase.co/storage/v1/object/public/assets

# Supabase
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=[ANON-KEY]

# URL pubblico del frontend Vercel
FRONTEND_URL=https://campionissimo.vercel.app

# Sicurezza — OBBLIGATORI, valori casuali unici
ADMIN_SECRET=[GENERARE-CON-secrets.token_hex(32)]
HINT_SIGN_KEY=[GENERARE-CON-secrets.token_hex(32)]

# App
APP_ENV=production
DEBUG=false
CORS_ORIGINS=["https://campionissimo.vercel.app"]
FUZZY_SCORE_THRESHOLD=55
