# =============================================================================
# CAMPIONISSIMO — Backend Environment Variables
# Copia in api/.env e NON committare mai il file .env su Git
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# Sviluppo: SQLite
DATABASE_URL=sqlite:///../data/tm_data_v2.db
# Produzione: PostgreSQL Supabase (sostituire con i valori reali)
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ── Asset ─────────────────────────────────────────────────────────────────────
# Sviluppo: cartella locale servita da FastAPI
ASSETS_LOCAL_DIR=../data/assets
ASSETS_BASE_URL=http://localhost:8000
# Produzione: Supabase Storage
# ASSETS_BASE_URL=https://[PROJECT-REF].supabase.co/storage/v1/object/public/assets

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Sicurezza ─────────────────────────────────────────────────────────────────
# Chiave casuale per endpoint admin — generare con: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET=
# Chiave HMAC per firmare i valori degli indizi sensibili (foto) — CAMBIARE in produzione
HINT_SIGN_KEY=

# ── URL Frontend ──────────────────────────────────────────────────────────────
# Usato per costruire i link di sfida condivisibili
FRONTEND_URL=http://localhost:5173
# Produzione:
# FRONTEND_URL=https://campionissimo.vercel.app

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
# Produzione:
# APP_ENV=production
# DEBUG=false

# CORS: lista JSON degli URL frontend autorizzati
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]
# Produzione (aggiungere il proprio dominio Vercel):
# CORS_ORIGINS=["https://campionissimo.vercel.app","https://tuodominio.com"]

# ── Search ────────────────────────────────────────────────────────────────────
FUZZY_SCORE_THRESHOLD=55
