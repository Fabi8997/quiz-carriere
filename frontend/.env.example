# =============================================================================
# CAMPIONISSIMO — Frontend Environment Variables
# Copia in frontend/.env.local (sviluppo) o imposta su Vercel (produzione)
# Le variabili VITE_* sono esposte al browser — non mettere segreti qui
# =============================================================================

# URL del backend API
# Sviluppo: lasciare vuoto (usa il proxy Vite → /api → localhost:8000)
VITE_API_BASE_URL=
# Produzione: URL pubblico del backend Fly.io
# VITE_API_BASE_URL=https://campionissimo.fly.dev

# URL base degli asset (foto giocatori, stemmi club, bandiere)
# Sviluppo: lasciare vuoto (usa /assets → proxy Vite → backend locale)
VITE_ASSETS_BASE_URL=
# Produzione: URL pubblico Supabase Storage
# VITE_ASSETS_BASE_URL=https://[PROJECT-REF].supabase.co/storage/v1/object/public/assets
