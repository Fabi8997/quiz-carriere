# ── PRODUZIONE — impostare come Environment Variables su Vercel ───────────────
# Le variabili VITE_* vengono incluse nel bundle JS — NON mettere segreti qui

# URL pubblico del backend Fly.io
VITE_API_BASE_URL=https://campionissimo.fly.dev

# URL pubblico degli asset su Supabase Storage
VITE_ASSETS_BASE_URL=https://[PROJECT-REF].supabase.co/storage/v1/object/public/assets
